<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('./partials/navbar') %>

<h1>My Entries</h1>

<% entries.forEach((entry) => { %>

    <h2><%= entry.title %></h2>

    <p><%= entry.entryBody %></p>
    <a href="/entries/<%= oneEntry._id %>/edit">Edit Entry</a>
            <form action="/entries/<%= oneEntry._id %>?_method=DELETE" method="post">
                <button>Delete Entry</button>
            </form>

<% }) %>
</body>
</html>